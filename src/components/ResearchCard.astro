---
import type { CollectionEntry } from 'astro:content';
import TechTags from './TechTags.astro';
interface Props { item: CollectionEntry<'research'>; index?: number; }
const { item, index } = Astro.props;
---

<a class="card" href={`/research/${item.id}/`}>
  {index !== undefined && <span class="card-index">RESEARCH {String(index + 1).padStart(2, '0')}</span>}
  <h3>{item.data.title}</h3>
  <p>{item.data.summary}</p>
  <TechTags tags={item.data.topics.slice(0, 4)} />
  <div class="card-footer"><span>{item.data.status}</span><span>Read topic →</span></div>
</a>
