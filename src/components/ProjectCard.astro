---
import type { CollectionEntry } from 'astro:content';
import TechTags from './TechTags.astro';
interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index } = Astro.props;
---

<a class="card" href={`/projects/${project.id}/`}>
  {index !== undefined && <span class="card-index">PROJECT {String(index + 1).padStart(2, '0')}</span>}
  <h3>{project.data.title}</h3>
  <p>{project.data.summary}</p>
  <TechTags tags={project.data.tags.slice(0, 4)} />
  <div class="card-footer"><span>{project.data.status}</span><span>View project →</span></div>
</a>
